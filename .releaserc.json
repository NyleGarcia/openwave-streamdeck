{
  "branches": ["main", { "name": "next", "prerelease": "next" }],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [{ "type": "polish", "release": "patch" }]
      }
    ],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python3 scripts/set_version.py ${nextRelease.version} && sh scripts/package.sh"
      }
    ],
    [
      "@semantic-release/github",
      { "assets": [{ "path": "dist/openwave-streamdeck-*.zip", "label": "OpenDeck plugin" }] }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "dev.openwave.sdPlugin/manifest.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
